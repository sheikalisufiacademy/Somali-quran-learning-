# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEBIRR_BASE_URL: Base URL for Telebirr Payment API (e.g. https://your-telebirr-gateway.com)
# The server sends POST {TELEBIRR_BASE_URL}/create/order with { title, amount }
TELEBIRR_BASE_URL="https://telebirr.et"
